# Optional: enables NewsAPI headlines on the election-results page.
NEWS_API_KEY=

# Optional override for citizen EC8A upload storage (default: ./data/live-submissions).
LIVE_SUBMISSIONS_DIR=

# GRID3 Nigeria ArcGIS FeatureServer layer URLs (public, no API key).
GRID3_STATE_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_State_Boundaries_V2/FeatureServer/0
GRID3_LGA_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_LGA_Boundaries_2/FeatureServer/0
GRID3_WARD_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/NGA_Ward_Boundaries/FeatureServer/0
GRID3_HEALTH_URL=https://services3.arcgis.com/BU6Aadhn6tbBEdyk/arcgis/rest/services/GRID3_NGA_health_facilities_v2_0/FeatureServer/0

# Official election result datasets (JSON) used for map choropleths and result panels.
# Files live under data/election-results/ by default.
ELECTION_RESULTS_DIR=./data/election-results
ELECTION_RESULTS_SOURCE_URL=https://www.inecnigeria.org/
INEC_IREV_URL=https://cvr.inecnigeria.org/

# SQLite database for fast polling-unit and election-result queries.
ELECTION_DB_PATH=./data/election-dashboard.db

# Optional overrides for JSON admin studios (default paths under ./data/).
# PAGE_CONTENT_PATH=./data/page-content.json
# MAP_CONFIGS_PATH=./data/map-configs.json

# Optional Google geocoding for polling-unit points missing coordinates.
GOOGLE_MAPS_API_KEY=
GEOCODE_POLLING_UNITS=false

# Docker Compose generates persistent local database and session secrets in a
# private named volume. Direct Node deployments may set the variables below or
# the corresponding *_FILE variables.
POSTGRES_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_SECRET_FILE=
EDITORIAL_DATABASE_URL=postgresql://election_app:change-me@localhost:5432/election_dashboard
EDITORIAL_DATABASE_PASSWORD_FILE=
BASE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
COOKIE_SECURE=false
SOURCE_ARCHIVE_ROOT=D:\Election Dashboard Data\source-archive
SOURCE_STORAGE=local
ENABLE_INEC_DISCOVERY=false

# Local admin login (preferred). Creates HttpOnly election_admin_session cookie.
# Bootstrap when data/admin-credentials.json is missing:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Or supply a precomputed scrypt hash from: node scripts/hash-admin-password.js
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Primary Admin
# Session identity / primary allow-list manager (lowercase email).
PRIMARY_ADMIN_EMAIL=geoinfotechgisteam@gmail.com
# Optional alias used only if PRIMARY_ADMIN_EMAIL is unset during bootstrap:
# ADMIN_EMAIL=

# Copy admin-credentials.example.json -> data/admin-credentials.json for file-based users.
# Copy admin-access.example.json -> admin-access.json for the email allow-list.

# Deprecated: Google OAuth is no longer used for admin sign-in.
# Keep only if you still run server-side Drive scripts with a separate OAuth client
# (credentials.json + token.json). Admin login does not require these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3010/auth/google/callback

# Off-site archive backup. The backup script requires gcloud authentication.
GCS_SOURCE_ARCHIVE_BUCKET=
